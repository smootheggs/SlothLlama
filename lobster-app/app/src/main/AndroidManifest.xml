<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The SlothLobster is the one that goes online, so SlothLlama never has to. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Brought back" and "a page you watch changed" notices. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Staying awake to check the mailbox, with a quiet notification while it does. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- (1.14) Holding the tablet awake while a round runs, so an edition isn't cut off halfway. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- (1.14) The edition at its time. Off until you allow "Alarms & reminders" for the Lobster;
         without it the alarm is inexact and the paper can come a few minutes late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- The hand-off with SlothLlama (1.11): only an app signed with the same key can hold it, so
         only SlothLlama can ask the Lobster to open a story, and only the Lobster can answer. -->
    <permission
        android:name="${applicationId}.permission.HAND_OFF"
        android:label="Open stories with the SlothLobster"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.HAND_OFF" />

    <queries>
        <!-- Browsers that open pages in an in-app view (Chrome's Custom Tabs). -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- SlothLlama, the only app the tab's buttons go back to. -->
        <package android:name="app.localmind.assistant" />
        <package android:name="app.localmind.assistant.debug" />
    </queries>

    <application
        android:name=".LobsterApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.SlothLobster">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share a link or some words from any app: it becomes a new order to check and send. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Save for later" in the share sheet: one tap, no screen; the page goes to SlothLlama's Later shelf. -->
        <activity
            android:name=".SaveForLaterActivity"
            android:exported="true"
            android:label="Save for later"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- SlothLlama's "open the page": a story it brought, in Chrome's in-app view. No screen
             of its own; needs the hand-off permission above. -->
        <activity
            android:name=".OpenStoryActivity"
            android:exported="true"
            android:permission="${applicationId}.permission.HAND_OFF"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="app.slothlobster.action.OPEN_STORY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".run.LobsterService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/fgs_reason" />
        </service>

        <!-- Android's own broadcasts only: not exported, so no other app can send to it. -->
        <receiver
            android:name=".run.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- (1.14) The edition's alarm. Reached only by this app's own immutable alarm intent. -->
        <receiver
            android:name=".run.EditionAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
