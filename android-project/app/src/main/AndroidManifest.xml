<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Air-gapped by design: no network permissions at all, and tools:node="remove" strips any
         that a library tries to add. Android then blocks every socket this app could open, so
         prompts, chats and models physically cannot leave the device. Models arrive by import. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <!-- Voice input: recorded and transcribed on the device, asked for the first time you tap the mic. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Only for the optional daily flashcard reminder; asked when you switch it on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Offline tools: "set a timer / alarm" goes to the clock app; the calendar is read only when
         you switch it on in Settings and ask about it. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- "Open the page" in the Express: the SlothLobster opens the story in Chrome's in-app view,
         so this app still has no network at all. The Lobster's hand-off permission is
         signature-level: only an app signed with your key holds it, both ways. -->
    <uses-permission android:name="${lobsterId}.permission.HAND_OFF" />

    <!-- Android 11+ package visibility: lets the app bind the text-to-speech engine -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Ourjong, the mahjong app (release and dev builds): only so Home can open it. Nothing is shared with it. -->
        <package android:name="app.ourjong" />
        <package android:name="app.ourjong.debug" />
        <!-- The SlothLobster: only to hand it a story's link to open. -->
        <package android:name="app.slothlobster" />
        <package android:name="app.slothlobster.debug" />
    </queries>

    <application
        android:name=".LocalMindApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        tools:replace="android:allowBackup,android:label">

        <!-- Lets the GPU backend reach the vendor OpenCL driver on Android 12+ (ignored if absent) -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Ask SlothLlama" in other apps' text-selection menu. Only forwards the selected text to
             the chat box; nothing is sent until you tap send. -->
        <activity
            android:name=".AskActivity"
            android:exported="true"
            android:label="@string/ask_slothllama"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Share to SlothLlama" from any app: text, links, photos, PDFs, books. A small sheet
             offers what fits; chat options wait in the message box until you tap send. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/share_to_slothllama"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/xhtml+xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!-- The Lobster's Chrome tab coming back: "Read it clean in SlothLlama" and "Save for
             later". Only the SlothLobster can start it (its signature-level permission), and only
             stories already in a paper here are acted on. -->
        <activity
            android:name=".FromLobsterActivity"
            android:exported="true"
            android:permission="${lobsterId}.permission.HAND_OFF"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Custom Hilt WorkerFactory initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
